<Window x:Class="Mirror.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mirror" Width="1120" Height="720" MinWidth="680" MinHeight="460"
        Background="Black" Foreground="White"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen"
        Icon="assets/Mirror.ico"
        PreviewKeyDown="OnPreviewKeyDown"
        Loaded="OnLoaded" Closing="OnClosing" StateChanged="OnStateChanged">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons</FontFamily>
        <SolidColorBrush x:Key="PillBrush" Color="#99161616" />
        <SolidColorBrush x:Key="PillHoverBrush" Color="#CC3A3A3A" />

        <Style x:Key="BarButton" TargetType="ButtonBase">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PillBrush}" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PillHoverBrush}" />
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="#141414" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ModeButton" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="16" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="#141414" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B8B8B8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" MouseLeftButtonDown="OnRootClick">
        <!-- Preview -->
        <Image x:Name="Preview" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality">
            <Image.RenderTransform>
                <ScaleTransform x:Name="PreviewFlip" ScaleX="-1" />
            </Image.RenderTransform>
        </Image>

        <!-- Rule of thirds, kept exactly over the picture -->
        <Grid x:Name="GridOverlay" IsHitTestVisible="False" Visibility="Collapsed"
              Width="{Binding ActualWidth, ElementName=Preview}"
              Height="{Binding ActualHeight, ElementName=Preview}"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#88FFFFFF" BorderThickness="0,1" />
            <Border Grid.Column="1" Grid.RowSpan="3" BorderBrush="#88FFFFFF" BorderThickness="1,0" />
        </Grid>

        <Rectangle x:Name="Flash" Fill="White" Opacity="0" IsHitTestVisible="False" />

        <TextBlock x:Name="CountdownText" Visibility="Collapsed" FontSize="140" FontWeight="SemiBold"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.8" />
            </TextBlock.Effect>
        </TextBlock>

        <!-- Recording status -->
        <Border x:Name="RecBadge" Visibility="Collapsed" Background="{StaticResource PillBrush}" CornerRadius="16"
                Padding="12,6" Margin="0,16,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Fill="#FF4545" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="RecTime" Text="00:00" FontSize="14" />
            </StackPanel>
        </Border>

        <!-- Top controls -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16">
            <ToggleButton x:Name="MirrorToggle" Style="{StaticResource BarButton}" ToolTip="{DynamicResource S.Tip.Mirror}"
                          Checked="OnMirrorToggled" Unchecked="OnMirrorToggled">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8AB;" Margin="0,0,7,0" />
                    <TextBlock Text="{DynamicResource S.Mirror}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="BackgroundToggle" Style="{StaticResource BarButton}"
                          ToolTip="{DynamicResource S.Tip.Background}" ToolTipService.ShowOnDisabled="True"
                          Checked="OnBackgroundPanelToggled" Unchecked="OnBackgroundPanelToggled">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE91B;" Margin="0,0,7,0" />
                    <TextBlock x:Name="BackgroundLabel" Text="{DynamicResource S.Background}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="GridToggle" Style="{StaticResource BarButton}" ToolTip="{DynamicResource S.Tip.Grid}"
                          Checked="OnGridToggled" Unchecked="OnGridToggled">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE80A;" />
            </ToggleButton>
            <Button x:Name="TimerButton" Style="{StaticResource BarButton}" ToolTip="{DynamicResource S.Tip.Timer}" Click="OnTimerClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE916;" />
                    <TextBlock x:Name="TimerLabel" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </StackPanel>
            </Button>
            <Button x:Name="SwitchCameraButton" Style="{StaticResource BarButton}" ToolTip="{DynamicResource S.Tip.SwitchCamera}"
                    Visibility="Collapsed" Click="OnSwitchCameraClick">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE89E;" />
            </Button>
            <Button Style="{StaticResource BarButton}" ToolTip="{DynamicResource S.Tip.Fullscreen}" Click="OnFullscreenClick">
                <TextBlock x:Name="FullscreenIcon" Style="{StaticResource IconText}" Text="&#xE740;" />
            </Button>
            <ToggleButton x:Name="SettingsToggle" Style="{StaticResource BarButton}" ToolTip="{DynamicResource S.Tip.Settings}"
                          Checked="OnSettingsToggled" Unchecked="OnSettingsToggled">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" />
            </ToggleButton>
        </StackPanel>

        <!-- Bottom controls -->
        <Grid VerticalAlignment="Bottom" Margin="24,0,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Button x:Name="LastCaptureButton" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Width="56" Height="56" Focusable="False" Cursor="Hand" Visibility="Collapsed"
                    ToolTip="{DynamicResource S.Tip.Gallery}" Click="OnLastCaptureClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" BorderBrush="White" BorderThickness="2" Background="#222"
                                Padding="1">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <!-- An image brush fills the tile and crops evenly around the centre of the picture. -->
                <Border CornerRadius="8">
                    <Border.Background>
                        <ImageBrush x:Name="LastCaptureBrush" Stretch="UniformToFill"
                                    AlignmentX="Center" AlignmentY="Center" />
                    </Border.Background>
                </Border>
            </Button>

            <Button x:Name="ShutterButton" Grid.Column="1" Width="76" Height="76" Focusable="False" Cursor="Hand"
                    ToolTip="{DynamicResource S.Tip.Shutter}" Click="OnShutterClick" RenderTransformOrigin="0.5,0.5">
                <Button.RenderTransform>
                    <ScaleTransform x:Name="ShutterScale" />
                </Button.RenderTransform>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse Stroke="White" StrokeThickness="4" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Border x:Name="ShutterCore" Width="60" Height="60" CornerRadius="30" Background="White" />
            </Button>

            <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="{StaticResource PillBrush}" CornerRadius="20" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="PhotoMode" Style="{StaticResource ModeButton}" Content="{DynamicResource S.Photo}"
                                 GroupName="Mode" Checked="OnModeChecked" />
                    <RadioButton x:Name="VideoMode" Style="{StaticResource ModeButton}" Content="{DynamicResource S.Video}"
                                 GroupName="Mode" Checked="OnModeChecked" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Starting / error state -->
        <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
            <TextBlock x:Name="StatusText" Text="{DynamicResource S.OpeningCamera}" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" />
            <StackPanel x:Name="StatusActions" Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,16,0,0" Visibility="Collapsed">
                <Button Content="{DynamicResource S.Retry}" Click="OnRetryClick" Margin="0,0,8,0" />
                <Button x:Name="PrivacyButton" Content="{DynamicResource S.OpenPrivacy}" Click="OnPrivacyClick" />
            </StackPanel>
        </StackPanel>

        <!-- Toast -->
        <Border x:Name="Toast" Visibility="Collapsed" Background="#E6202020" CornerRadius="8" Padding="14,8"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,112" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" FontSize="13" TextWrapping="Wrap" MaxWidth="480" />
        </Border>

        <!-- Background picker -->
        <Border x:Name="BackgroundPanel" Visibility="Collapsed" Width="372" HorizontalAlignment="Right"
                Margin="0,64,16,16" VerticalAlignment="Top" Background="#F2202020" CornerRadius="12"
                BorderBrush="#33FFFFFF" BorderThickness="1" MouseLeftButtonDown="OnSettingsPanelClick">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                <StackPanel Margin="14,4,14,16">
                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource S.Background}"
                               TextWrapping="Wrap" />
                    <WrapPanel x:Name="BackgroundTiles" />
                    <StackPanel x:Name="BlurStrengthRow" Margin="4,0">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource S.BlurStrength}" />
                        <Slider x:Name="BlurStrengthSlider" Minimum="2" Maximum="14" SmallChange="1" LargeChange="2"
                                ValueChanged="OnBlurStrengthChanged" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Settings -->
        <Border x:Name="SettingsPanel" Visibility="Collapsed" Width="320" HorizontalAlignment="Right"
                Margin="0,64,16,16" VerticalAlignment="Top" Background="#F2202020" CornerRadius="12"
                BorderBrush="#33FFFFFF" BorderThickness="1" MouseLeftButtonDown="OnSettingsPanelClick">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                <StackPanel Margin="18,4,18,18">
                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource S.Language}" />
                    <ComboBox x:Name="LanguageCombo" HorizontalAlignment="Stretch" SelectionChanged="OnLanguageChanged" />
                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource S.Camera}" />
                    <ComboBox x:Name="CameraCombo" HorizontalAlignment="Stretch" SelectionChanged="OnCameraChanged" />

                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource S.Resolution}" />
                    <ComboBox x:Name="ModeCombo" HorizontalAlignment="Stretch" SelectionChanged="OnVideoModeChanged"
                              MaxDropDownHeight="280" />

                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource S.Saving}" />
                    <CheckBox x:Name="SaveMirroredCheck" Content="{DynamicResource S.SaveMirrored}" Click="OnSaveMirroredClick" />
                    <CheckBox x:Name="RecordAudioCheck" Content="{DynamicResource S.RecordAudio}" Click="OnRecordAudioClick" Margin="0,4,0,0" />

                    <StackPanel x:Name="BrightnessRow">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource S.Brightness}" />
                        <Slider x:Name="BrightnessSlider" ValueChanged="OnBrightnessChanged" />
                    </StackPanel>
                    <StackPanel x:Name="ContrastRow">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource S.Contrast}" />
                        <Slider x:Name="ContrastSlider" ValueChanged="OnContrastChanged" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button x:Name="ResetPictureButton" Content="{DynamicResource S.ResetPicture}" Click="OnResetPictureClick"
                                Margin="0,0,8,0" />
                        <Button Content="{DynamicResource S.OpenFolder}" Click="OnOpenFolderClick" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
